    mpi:
      buildable: false
      require: "nvhpc"
    nvhpc:
      externals:
      - spec: nvhpc@25.9+blas+lapack+mpi
        prefix: /opt/nvidia/hpc_sdk
        extra_attributes:
          environment:
            prepend_path:
              PATH: /opt/nvidia/hpc_sdk/Linux_x86_64/25.9/comm_libs/mpi
          compilers:
            c: /opt/nvidia/hpc_sdk/Linux_x86_64/25.9/compilers/bin/nvc
            cxx: /opt/nvidia/hpc_sdk/Linux_x86_64/25.9/compilers/bin/nvc++
            fortran: /opt/nvidia/hpc_sdk/Linux_x86_64/25.9/compilers/bin/nvfortran
      buildable: false